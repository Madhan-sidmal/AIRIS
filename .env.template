# AIRIS Environment Configuration
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airis
POSTGRES_USER=airis_user
POSTGRES_PASSWORD=your_secure_password_here

# MinIO (local S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=airis-raw
MINIO_BUCKET_CLEAN=airis-clean

# Google Trends (no key needed, uses pytrends)
GOOGLE_TRENDS_GEO=IN

# Agmarknet
AGMARKNET_BASE_URL=https://agmarknet.gov.in

# TRAI
TRAI_REPORT_BASE_URL=https://www.trai.gov.in/release-publication/reports/telecom-subscription-data

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/airis.log

# Research output
OUTPUT_DIR=data/features
RESEARCH_DIR=research
